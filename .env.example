# =============================================================================
# SantaR · Configuración del entorno. Copie este archivo como .env y complételo.
# El archivo .env NUNCA se sube al repositorio (contiene claves y contraseñas).
# =============================================================================

APP_NAME=SantaR
# local (desarrollo) | production (hosting)
APP_ENV=local
# Se genera con: php artisan key:generate
APP_KEY=
# En producción SIEMPRE false (no mostrar errores técnicos al usuario).
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Producción: LOG_STACK=daily y LOG_LEVEL=warning
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4 (local) o MariaDB del hosting
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bd_santar
DB_USERNAME=root
DB_PASSWORD=

# RN-05: la sesión se cierra tras 15 minutos de inactividad.
SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=false
SESSION_EXPIRE_ON_CLOSE=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Producción (HTTPS): true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# El hosting compartido no tiene procesos en segundo plano (SAD, vista de procesos).
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@santar.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# SantaR
# --------------------------------------------------------------------------
# Cuenta única del encargado de sede (rol Administrador), creada con: php artisan db:seed
# La contraseña debe tener al menos 8 caracteres, con letras y números (RN-04).
ADMIN_NOMBRE="Encargado de sede"
ADMIN_CORREO=encargado@santar.test
ADMIN_PASSWORD=

# Catálogo de demostración (solo para el ambiente de pruebas; nunca con datos reales del cliente).
DATOS_DEMO=false

# Producción en el hosting (RNF-06): forzar HTTPS y confiar en el proxy del proveedor.
FORCE_HTTPS=false
TRUSTED_PROXIES=
